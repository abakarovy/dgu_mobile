# При таймаутах cdn.cocoapods.org используем Git-репозиторий спек. Вместе с этим см. блок
# FlutterMacOS ниже: только Git source иногда ломает резолв для darwin-плагинов без локальной спеки.
source 'https://github.com/CocoaPods/Specs.git'

# firebase_core 4.x requires iOS 15+ (Firebase iOS SDK)
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# CocoaPods только для macOS добавляет FlutterMacOS из Flutter/ephemeral; для iOS — нет.
# Плагины с podspec в `darwin/` (например shared_preferences_foundation) объявляют `s.osx.dependency 'FlutterMacOS'`.
# С нестандартными `source` в Podfile резолвер иногда требует эту спеку с trunk — её там нет.
# Локальный placeholder совпадает с podhelper `flutter_install_macos_engine_pod` (см. FLUTTER_ROOT/.../podhelper.rb).
def flutter_install_ios_fluttermacos_placeholder_pod(ios_application_path)
  ephemeral_dir = File.join(ios_application_path, 'Flutter', 'ephemeral')
  system('mkdir', '-p', ephemeral_dir)
  copied_podspec_path = File.join(ephemeral_dir, 'FlutterMacOS.podspec')
  File.open(copied_podspec_path, 'w') do |podspec|
    podspec.write <<~PODSPEC
      #
      # This podspec is NOT to be published. It is only used as a local source!
      # This is a generated file; do not edit or check into version control.
      #

      Pod::Spec.new do |s|
        s.name             = 'FlutterMacOS'
        s.version          = '1.0.0'
        s.summary          = 'A UI toolkit for beautiful and fast apps.'
        s.homepage         = 'https://flutter.dev'
        s.license          = { :type => 'BSD' }
        s.author           = { 'Flutter Dev Team' => 'flutter-dev@googlegroups.com' }
        s.source           = { :git => 'https://github.com/flutter/engine', :tag => s.version.to_s }
        # CocoaPods rejects a pod on an iOS target if it declares only macOS — add iOS to match Runner.
        # Real macOS/engine linking is unrelated; это только заглушка для резолва darwin-podspec при Git source.
        s.ios.deployment_target = '15.0'
        s.osx.deployment_target = '10.15'
        # Framework linking is handled by Flutter tooling, not CocoaPods.
        # Add a placeholder to satisfy `s.dependency 'FlutterMacOS'` plugin podspecs.
        s.vendored_frameworks = 'path/to/nothing'
      end
    PODSPEC
  end
  pod 'FlutterMacOS', path: File.join('Flutter', 'ephemeral')
end

target 'Runner' do
  # Динамические frameworks: иначе Xcode не находит модуль connectivity_plus (Swift-плагин) в GeneratedPluginRegistrant.m.
  use_frameworks!

  flutter_install_ios_fluttermacos_placeholder_pod(File.dirname(File.realpath(__FILE__)))
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # После «Update to recommended settings» у Pods.xcodeproj Xcode может включить Module Verifier
  # и сбросить наследование путей — снова ломается поиск Flutter/Flutter.h у плагинов.
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'
    config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
  end

  # Предупреждения из исходников плагинов (pub-cache): deprecated API, pointer cast и т.д.
  # Их нельзя править в проекте — только ждать апдейта пакета; для чистой сборки отключаем warn в этих pod-таргетах.
  noisy_plugin_targets = %w[
    firebase_core
    firebase_messaging
    image_picker_ios
    permission_handler_apple
  ]

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['DEFINES_MODULE'] = 'YES'
      config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
      # Некоторые podspec'и (особенно privacy pods) могут приносить iOS 9.0 как дефолт.
      # Принудительно выравниваем deployment target с проектом, иначе Xcode ругается.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # Xcode 14.3+: проверка модулей для pod-фреймворков даёт лишний шум (в т.ч. dummy.o / VerifyModule).
      config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'

      if noisy_plugin_targets.include?(target.name)
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      end

      next if config.name == 'Debug'
      # Match App Store / crash symbolication expectations for pod frameworks
      config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
    end
    # Повторно: наши флаги не должны перетирать FRAMEWORK_SEARCH_PATHS к Flutter из podhelper.
    flutter_additional_ios_build_settings(target)
  end

end
